  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@mcansh/http-helmet": "^0.13.2",
    "cloudinary-build-url": "^0.2.4",
    "remix": "^3.0.0-rc.3"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.9.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
