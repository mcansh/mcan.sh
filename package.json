  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@mcansh/http-helmet": "^0.13.2",
    "cloudinary-build-url": "^0.2.4",
    "remix": "3.0.0-rc.1"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.25.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
