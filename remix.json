{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "mounts": {
      "app": "app",
      "npm": "node_modules"
    },
    "allowFiles": ["app/routes.ts", "app/**/public/**"],
    "allowPackages": ["remix"],
    "denyFiles": ["app/**/*.test.*"],
    "files": {
      "extensions": [".avif", ".gif", ".jpeg", ".jpg", ".png", ".svg", ".webp", ".woff2"]
    }
  }
}
